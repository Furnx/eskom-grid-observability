# ============================================================================
# dbt Profile Configuration — TEMPLATE
# ============================================================================
#
# Copy this file to `profiles.yml` and adjust the path to your local
# DuckDB database file.
#
#   cp profiles.yml.example profiles.yml
#
# profiles.yml is gitignored — your local copy will NOT be committed.
# ============================================================================

eskom_grid_observability:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: '../data/eskom_data.duckdb'
      extensions:
        - json

    # Cloud deployment target (eskom-grid-cloud). The transform function
    # downloads the warehouse file from S3 to a writable path, runs dbt, and
    # uploads it back. httpfs lets DuckDB read s3://.../raw/**/*.json directly;
    # S3 credentials for DuckDB are configured in Phase 2 of the cloud project.
    prod:
      type: duckdb
      path: "{{ env_var('ESKOM_DUCKDB_PATH', '/tmp/eskom_data.duckdb') }}"
      extensions:
        - json
        - httpfs
