# ============================================================================
# dbt Profile Configuration — TEMPLATE
# ============================================================================
#
# Copy this file to `profiles.yml` and adjust the path to your local
# DuckDB database file.
#
#   cp profiles.yml.example profiles.yml
#
# profiles.yml is gitignored — your local copy will NOT be committed.
# ============================================================================

eskom_grid_observability:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: '../data/eskom_data.duckdb'
      extensions:
        - json

    # Cloud deployment target (eskom-grid-cloud). The transform Lambda copies
    # this file into its image as profiles.yml, so it must be correct.
    #
    #   path                : the warehouse is downloaded from S3 to /tmp, built,
    #                         and uploaded again; /tmp is the only writable place
    #                         in Lambda.
    #   threads             : 1 - the models are tiny and a single writer keeps
    #                         DuckDB's memory use predictable in a small function.
    #   extension_directory : extensions are installed into the image at build
    #                         time, since the function has no network route to
    #                         DuckDB's extension repository at runtime.
    #   secrets             : credential_chain picks up the Lambda execution
    #                         role's credentials from the environment; no keys
    #                         are ever written here.
    prod:
      type: duckdb
      path: "{{ env_var('ESKOM_DUCKDB_PATH', '/tmp/eskom_data.duckdb') }}"
      threads: 1
      extensions:
        - httpfs
        - aws
      settings:
        extension_directory: "{{ env_var('DUCKDB_EXTENSION_DIRECTORY', '/opt/duckdb_extensions') }}"
      secrets:
        - type: s3
          provider: credential_chain
          region: af-south-1
